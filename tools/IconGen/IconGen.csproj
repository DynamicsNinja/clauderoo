<Project Sdk="Microsoft.NET.Sdk">

  <!-- Build-time tool: draws the clauderoo mark and writes src/Clauderoo.Tray/Icons/*.ico.
       Not referenced by the apps. Run from the repo root: dotnet run (project tools/IconGen), optionally passing an output dir. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Clauderoo.Tray\IcoFile.cs" Link="IcoFile.cs" />
  </ItemGroup>

</Project>
