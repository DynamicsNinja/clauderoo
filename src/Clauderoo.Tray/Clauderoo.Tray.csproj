<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>clauderoow</AssemblyName>
    <RootNamespace>Clauderoo.Tray</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Icons\app.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Generated by tools/IconGen; loaded through AppIcons. -->
    <EmbeddedResource Include="Icons\*.ico" LogicalName="Clauderoo.Tray.Icons.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Clauderoo.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Clauderoo.Core\Clauderoo.Core.csproj" />
  </ItemGroup>

</Project>
